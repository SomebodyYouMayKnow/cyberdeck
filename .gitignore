.pio/
.vscode/
__pycache__/
*.pyc
*.log
*.bak
*.zip
*.stl
*.step
*.f3d
!cad/*.step
work/

# Local scratch scripts and design notes stay out of the public repository.
/scripts/
/docs/
/outputs/

# Fusion automation and generated audits are local development artifacts.
/cad/FusionScripts/
/cad/Export_Neonred_PCB_STEP.py
/cad/*audit*.json

# Publish only PCB screenshots, prior Gerber packages, and the current Gerber.
/PCB/*
!/PCB/screenshots/
!/PCB/past gerbers/
!/PCB/NEONRED_Gerbers_current_2026-11-18.zip
/PCB/screenshots/*
!/PCB/screenshots/*.png
!/PCB/screenshots/*.jpg
!/PCB/screenshots/*.jpeg
/PCB/past gerbers/*
!/PCB/past gerbers/*.zip
